# Copy this file to .env and fill in your real keys.
# Never commit .env to version control.

# ── Football data provider selection ─────────────────────────────────────────
# FOOTBALL_PROVIDER controls which provider is used:
#   auto          — football-data.org if key set, else api-sports.io/ESPN (default)
#   football_data — football-data.org first, fall back to api-sports.io/ESPN
#   api_football  — api-sports.io/ESPN only (ignore football-data.org)
FOOTBALL_PROVIDER=auto

# ── Football API: football-data.org (primary/recommended) ────────────────────
# Free plan: https://www.football-data.org/client/register
# Covers PL, CL, BL1, DED, BSA, PD, FL1, ELC, PPL, EC, SA (forever-free)
FOOTBALL_DATA_API_KEY=your_football_data_key_here
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# ── Football API: API-Sports direct (fallback) ────────────────────────────────
# Get key at https://dashboard.api-football.com
API_FOOTBALL_KEY=your_apisports_key_here
API_FOOTBALL_MODE=apisports
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_HOST=v3.football.api-sports.io
APISPORTS_KEY=your_apisports_key_here

# ── NBA API (RapidAPI) ────────────────────────────────────────────────────────
NBA_API_KEY=your_rapidapi_key_here
NBA_API_HOST=nba-api-free-data.p.rapidapi.com
NBA_API_BASE_URL=https://nba-api-free-data.p.rapidapi.com

# ── Claude AI chatbot (Anthropic) ─────────────────────────────────────────────
# Get your key at https://console.anthropic.com
# Without this key the chatbot uses a built-in fallback responder.
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ── The Odds API ─────────────────────────────────────────────────────────────
# Get your key at https://the-odds-api.com
# Without this key, edge badges are hidden in the matchup view.
ODDS_API_KEY=your_odds_api_key_here

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
FLASK_USE_RELOADER=0
PORT=5000

# ── Local runtime storage (optional) ─────────────────────────────────────────
# By default, generated cache/tracking/report files are stored under <repo>/cache.
# Set this to a persistent disk path (e.g. /persistent) for production (Render, etc).
# All tracked data, reports, and user accounts will be stored under this root.
SCORPRED_DATA_ROOT=
