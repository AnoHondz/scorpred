# Copy this file to .env and fill in your real keys.
# Never commit .env to version control.

# ── Football API (football-data.org — RECOMMENDED FREE PROVIDER) ──────────────
# Register at https://www.football-data.org/client (free, no credit card)
# Covers: Premier League, La Liga, Serie A, Bundesliga, Ligue 1, Champions League, and more.
# Rate limit: 10 req/min — the client respects X-RateLimit-* response headers automatically.
FOOTBALL_DATA_KEY=your_football_data_org_key_here

# ── Football API (API-Sports / RapidAPI fallback) ─────────────────────────────
# Used if FOOTBALL_DATA_KEY is absent or the league isn't supported by football-data.org.
API_FOOTBALL_KEY=your_apisports_or_rapidapi_key_here
# Optional alias — RAPIDAPI_KEY is also accepted
RAPIDAPI_KEY=
API_FOOTBALL_MODE=apisports
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
API_FOOTBALL_HOST=v3.football.api-sports.io

# ── NBA API (RapidAPI) ────────────────────────────────────────────────────────
NBA_API_KEY=your_rapidapi_key_here
NBA_API_HOST=nba-api-free-data.p.rapidapi.com
NBA_API_BASE_URL=https://nba-api-free-data.p.rapidapi.com

# ── Claude AI chatbot (Anthropic) ─────────────────────────────────────────────
# Get your key at https://console.anthropic.com
# Without this key the chatbot uses a built-in fallback responder.
ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ── The Odds API ─────────────────────────────────────────────────────────────
# Get your key at https://the-odds-api.com
# Without this key, edge badges are hidden in the matchup view.
ODDS_API_KEY=your_odds_api_key_here
# Automatic player-prop comparisons use this key when present. No manual line entry.
# DraftKings/FanDuel only; 5-minute cache, 100-credit monthly local ceiling. No paid purchases.
PROP_ODDS_ENABLED=1
# Optional NFL market context. One region; 5-minute cache. Does not enable NFL BET picks.
NFL_ODDS_ENABLED=0
NFL_ODDS_REGION=us
# Primary modeling/history source. ESPN remains the explicit schedule fallback.
NFL_DATA_SOURCE=nflverse
# Separate descriptive NFL research API; does not change prediction outputs.
NFL_ADVANCED_RESEARCH_ENABLED=0
# Separate prospective winner research API; requires the advanced research gate.
NFL_WINNER_RESEARCH_ENABLED=0
# Separate NBA experimental preview API. Never changes production decisions.
NBA_EARLY_SEASON_RESEARCH_ENABLED=0
# Offline winner snapshots expire after one hour by default.
# NFL_WINNER_SNAPSHOT_MAX_SECONDS=3600
# Optional per-dataset import intervals (seconds), used with --refresh:
# NFL_REFRESH_PBP_SECONDS=86400
# NFL_REFRESH_FTN_CHARTING_SECONDS=21600
# NFL_REFRESH_PFR_PASS_WEEK_SECONDS=21600

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
FLASK_USE_RELOADER=0
PORT=5000

# ── Local runtime storage (optional) ─────────────────────────────────────────
# By default, generated cache/tracking/report files are stored under <repo>/cache.
# Set this to a persistent disk path (e.g. /persistent) for production (Render, etc).
# Tracking and generated caches live here; model releases stay with the build.
SCORPRED_DATA_ROOT=
SCORPRED_PERSISTENT_ROOT=
# One scheduler-owning process; disable for maintenance commands.
SCORPRED_SCHEDULER_ENABLED=1
# Optional opt-in daily digest: configure with scripts/daily_digest.py.
# Uses separate existing SMTP credentials; the chat Gmail connector is not inherited.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Provider response caches are pruned every 6 hours: files older than the age
# limit go first, then the oldest until the total fits under the size cap.
SCORPRED_CACHE_MAX_MB=300
SCORPRED_CACHE_MAX_AGE_DAYS=7
# Optional immutable model artifact directory; defaults to <repo>/data/models.
SCORPRED_MODEL_DIR=
